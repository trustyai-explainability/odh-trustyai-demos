ARG TRUSTYAI_BASE_IMAGE=quay.io/opendatahub/odh-trustyai-service-py:odh-stable

FROM --platform=linux/amd64 ${TRUSTYAI_BASE_IMAGE}

# The current odh-stable image contains pydantic 2.13.5 with pydantic-core
# 2.49.0. TrustyAI requires the matching pydantic-core 2.46.5. cloudpickle
# also repairs the image's joblib dependency reported by pip check.
USER 0
RUN python -m pip install --no-cache-dir \
    "pydantic-core==2.46.5" \
    "cloudpickle==3.1.2"
COPY local/trustyai_server.py /opt/app-root/src/trustyai_server.py
USER 1001
ENTRYPOINT ["python", "/opt/app-root/src/trustyai_server.py"]
